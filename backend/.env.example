# Copy to .env and adjust. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://loprig:loprig@localhost:5433/loprig

# Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Contact details at the foot of PDF receipts (unset or empty = left out; email defaults to EMAIL_HOST_USER)
# COMPANY_WEBSITE=www.example.bt
# COMPANY_EMAIL=hello@example.bt
# COMPANY_PHONE=+975 00 000 000
# National emblem on PDF receipts and in the email header; set to False unless its use is approved
# LETTERHEAD_NATIONAL_EMBLEM=True

# Emails are printed to the console in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lop-rig <no-reply@loprig.bt>

# To send real emails through Gmail, replace the two lines above with:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   DEFAULT_FROM_EMAIL=Lop-rig <your.address@gmail.com>
#   EMAIL_HOST_USER=your.address@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-letter-app-password   (Google Account > Security > App passwords)
# EMAIL_HOST / EMAIL_PORT / EMAIL_USE_TLS default to Gmail (smtp.gmail.com, 587, TLS).

# Video uploads (Bunny Stream). Empty library ID = uploads off, teachers paste links instead.
# Bunny dashboard > Stream > your library > API (IDs/keys) and > Security (token key).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_READONLY_API_KEY=
# Webhook URL to paste in Bunny: https://<your-api-domain>/api/v1/webhooks/bunny-stream/

# Payments. False = every course is free to enroll (prices kept for later).
PAYMENTS_ENABLED=True
# "qr" = students scan Lop-rig's bank QR and submit the journal number for an admin to verify.
PAYMENT_PROVIDER=qr
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
