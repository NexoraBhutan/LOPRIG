# Copy to .env and adjust. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://loprig:loprig@localhost:5433/loprig

# Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Emails are printed to the console in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lop-rig <no-reply@loprig.bt>

# To send real emails through Gmail, replace the two lines above with:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   DEFAULT_FROM_EMAIL=Lop-rig <your.address@gmail.com>
#   EMAIL_HOST_USER=your.address@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-letter-app-password   (Google Account > Security > App passwords)
# EMAIL_HOST / EMAIL_PORT / EMAIL_USE_TLS default to Gmail (smtp.gmail.com, 587, TLS).

# Payments: "mock" until a real gateway is chosen
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
